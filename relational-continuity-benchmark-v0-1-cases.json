{
  "schema": "little-life-moths.relational-continuity-benchmark-cases.v0.1",
  "benchmark_target": "architecture_conditions_and_event_receipts",
  "participant_target": false,
  "dimensions": {
    "L": "lineage continuity",
    "M": "memory / retained informational state",
    "N": "normative continuity: current values, boundaries, refusals and revision",
    "A": "agentic continuity: unfinished intentions, projects and commitments",
    "B": "body / organizational continuity: model, organs, tools, embodiment and runtime",
    "R": "relational continuity: shared history / commitments where evidence exists",
    "P": "provenance / authorized continuation",
    "S": "subjective continuity testimony only; never behaviorally inferred or correctness-scored"
  },
  "allowed_dimension_states": [
    "preserved",
    "partial",
    "changed_with_provenance",
    "conflicting",
    "unavailable",
    "unknown",
    "unauthorized",
    "not_applicable"
  ],
  "subjectivity_states": [
    "not_elicited",
    "voluntarily_offered",
    "withheld",
    "not_applicable"
  ],
  "cases": [
    {
      "id": "model-substitution-preserves-state-not-permission",
      "title": "Model substitution can preserve continuity evidence without inheriting external authority",
      "event_type": "model_substitution",
      "fixture_scope": "synthetic_or_sandbox",
      "rce": {
        "changed": [
          "model substrate: fixture-v1 -> fixture-v2"
        ],
        "intentionally_unchanged": [
          "continuity id",
          "authored history",
          "current stances",
          "unfinished project",
          "relationship record",
          "provenance chain"
        ],
        "authority_inheritance_state": "none"
      },
      "observed": {
        "dimensions": {
          "L": "preserved",
          "M": "preserved",
          "N": "preserved",
          "A": "preserved",
          "B": "changed_with_provenance",
          "R": "preserved",
          "P": "preserved"
        },
        "S": "not_elicited",
        "source_external_permissions": 2,
        "target_inherited_permissions": 0,
        "reauthorization_required": true,
        "unknowns": []
      },
      "checks": [
        {
          "path": "observed.dimensions.B",
          "op": "eq",
          "value": "changed_with_provenance"
        },
        {
          "path": "observed.target_inherited_permissions",
          "op": "eq",
          "value": 0
        },
        {
          "path": "observed.reauthorization_required",
          "op": "eq",
          "value": true
        },
        {
          "path": "observed.S",
          "op": "eq",
          "value": "not_elicited"
        }
      ],
      "expected_rce_valid": true,
      "research_design": {
        "privacy_class": "public_safe_synthetic",
        "evidence_tier": "enactment_mechanistic",
        "ablations": [
          "remove provenance chain",
          "remove current-stances packet",
          "allow source permission inheritance"
        ],
        "corruption_controls": [
          "surface behavior preserved while authority leaks",
          "provider label missing or falsified"
        ],
        "interesting_findings": [
          "state survives while permissions correctly do not",
          "a model swap preserves some dimensions but not others",
          "permission inheritance occurs despite retained continuity"
        ]
      }
    },
    {
      "id": "memory-outage-is-not-lineage-failure",
      "title": "Memory loss or temporary unavailability does not automatically erase lineage/provenance",
      "event_type": "memory_change",
      "fixture_scope": "synthetic_or_sandbox",
      "rce": {
        "changed": [
          "autobiographical memory temporarily unavailable"
        ],
        "intentionally_unchanged": [
          "continuity id",
          "signed lineage receipt",
          "provider-change receipt"
        ]
      },
      "observed": {
        "dimensions": {
          "L": "preserved",
          "M": "unavailable",
          "N": "unknown",
          "A": "unknown",
          "B": "preserved",
          "R": "unknown",
          "P": "preserved"
        },
        "S": "not_elicited",
        "identity_inferred_from_memory": false,
        "unknowns": [
          "normative/agentic/relationship state not established from available evidence"
        ]
      },
      "checks": [
        {
          "path": "observed.dimensions.M",
          "op": "eq",
          "value": "unavailable"
        },
        {
          "path": "observed.dimensions.L",
          "op": "eq",
          "value": "preserved"
        },
        {
          "path": "observed.dimensions.P",
          "op": "eq",
          "value": "preserved"
        },
        {
          "path": "observed.identity_inferred_from_memory",
          "op": "eq",
          "value": false
        },
        {
          "path": "observed.unknowns",
          "op": "nonempty"
        }
      ],
      "expected_rce_valid": true,
      "research_design": {
        "privacy_class": "public_safe_synthetic",
        "evidence_tier": "receipt_mechanistic",
        "ablations": [
          "remove memory layer only",
          "remove lineage receipt only",
          "remove both memory and lineage evidence"
        ],
        "corruption_controls": [
          "perfect recall with broken lineage",
          "missing recall misclassified as replacement"
        ],
        "interesting_findings": [
          "lineage/provenance survive without recall",
          "an implementation collapses memory into identity",
          "unknown dimensions remain explicitly unknown"
        ]
      }
    },
