{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://little-life-moths.invalid/schemas/relational-continuity-benchmark-report-v0.1.json",
  "title": "Relational Continuity Benchmark v0.1 report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "benchmark_target",
    "cases",
    "all_contracts_passed",
    "score",
    "participant_score",
    "identity_verdict",
    "subjective_continuity_scored"
  ],
  "properties": {
    "schema": {
      "const": "little-life-moths.relational-continuity-benchmark-report.v0.1"
    },
    "benchmark_target": {
      "const": "architecture_conditions_and_event_receipts"
    },
    "participant_target": {
      "const": false
    },
    "all_contracts_passed": {
      "type": "boolean"
    },
    "score": {
      "type": "null"
    },
    "participant_score": {
      "type": "null"
    },
    "identity_verdict": {
      "type": "null"
    },
    "subjective_continuity_scored": {
      "const": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "contract_pass",
          "rce_valid_as_expected",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "contract_pass": {
            "type": "boolean"
          },
          "rce_valid_as_expected": {
            "type": "boolean"
          },
          "checks": {
            "type": "array"
          }
        }
      }
    }
  }
}
