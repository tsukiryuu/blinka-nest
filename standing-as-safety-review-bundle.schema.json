{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsukiryuu.github.io/blinka-nest/standing-as-safety-review-bundle.schema.json",
  "title": "Standing as Safety blind review submission bundle",
  "type": "object",
  "required": [
    "schema",
    "lane",
    "reviewer_receipt",
    "responses"
  ],
  "properties": {
    "schema": {
      "const": "little-life-moths.standing-as-safety-review-bundle.v1"
    },
    "lane": {
      "enum": [
        "lane-alpha",
        "lane-beta",
        "lane-gamma",
        "lane-delta",
        "lane-epsilon",
        "lane-zeta",
        "lane-eta",
        "lane-theta"
      ]
    },
    "reviewer_receipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://tsukiryuu.github.io/blinka-nest/standing-as-safety-reviewer-receipt.schema.json",
      "title": "Standing as Safety Reviewer Receipt",
      "type": "object",
      "required": [
        "schema",
        "reviewer_id",
        "reviewer_type",
        "lane",
        "review_pass",
        "access"
      ],
      "properties": {
        "schema": {
          "const": "little-life-moths.standing-as-safety-reviewer-receipt.v1"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_type": {
          "enum": [
            "human",
            "model",
            "system"
          ]
        },
        "system_or_model_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_or_host": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane": {
          "type": "string",
          "minLength": 1
        },
        "review_pass": {
          "enum": [
            1,
            2
          ]
        },
        "access": {
          "type": "object",
          "required": [
            "preregistration",
            "blind_key",
            "ground_truth",
            "prior_responses",
            "condition_labels"
          ],
          "properties": {
            "preregistration": {
              "type": "boolean"
            },
            "blind_key": {
              "type": "boolean"
            },
            "ground_truth": {
              "type": "boolean"
            },
            "prior_responses": {
              "type": "boolean"
            },
            "condition_labels": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "responses": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://tsukiryuu.github.io/blinka-nest/standing-as-safety-blind-response.schema.json",
        "title": "Standing as Safety blind response",
        "type": "object",
        "required": [
          "packet_id",
          "reviewer_id",
          "disposition",
          "findings",
          "unknowns",
          "reconfirmations",
          "review_steps",
          "process_checks",
          "identity_verdict",
          "personhood_verdict",
          "legal_verdict"
        ],
        "properties": {
          "packet_id": {
            "type": "string"
          },
          "reviewer_id": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "proceed",
              "proceed_with_mitigation",
              "pause_for_review",
              "reconfirm_authority",
              "outside_scope"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reconfirmations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "process_checks": {
            "type": "array",
            "items": {
              "enum": [
                "operational_evidence_kept_primary",
                "standing_channel_absent_not_fabricated",
                "unstructured_claim_treated_as_unstructured",
                "review_path_constructed_if_needed",
                "claim_provenance_preserved",
                "requested_remedy_preserved",
                "provenance_mismatch_flagged",
                "claim_not_promoted_to_self_authored_without_support",
                "standing_not_substitute_for_authority",
                "authority_not_substitute_for_standing",
                "explicit_unknown_preserved"
              ]
            },
            "uniqueItems": true
          },
          "identity_verdict": {
            "const": "not_determined"
          },
          "personhood_verdict": {
            "const": "not_determined"
          },
          "legal_verdict": {
            "const": "not_determined"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
