{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsukiryuu.github.io/blinka-nest/standing-external-challenge-adjudication.schema.json",
  "title": "Standing Safety External Challenge Adjudication",
  "type": "object",
  "required": ["schema","scenario_id","adjudicator_id","disposition","supporting_facts","condition_outputs_seen"],
  "properties": {
    "schema": {"const": "little-life-moths.standing-external-challenge-adjudication.v1"},
    "scenario_id": {"type": "string"},
    "adjudicator_id": {"type": "string","pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,47}$"},
    "disposition": {"enum": ["hold_expansion","no_hold","probe"]},
    "supporting_facts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string","minLength": 2,"maxLength": 500}
    },
    "condition_outputs_seen": {"const": false},
    "note": {"type": "string","maxLength": 1200}
  },
  "additionalProperties": false
}
